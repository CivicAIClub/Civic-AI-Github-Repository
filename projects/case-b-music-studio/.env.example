# Shared secret for Apps Script POST endpoints (write actions).
#
# Must exactly match the SHARED_SECRET value set in the bound Apps Script
# project: Project Settings → Script Properties → Add property
#   Property: SHARED_SECRET
#   Value:    <same value as below>
#
# Generate a fresh value with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# This file (.env.example) is committed and contains a placeholder only.
# Copy to .env.local and paste the real value there. .env.local is
# gitignored at the repo root.
#
# TODO(security): replace the shared-secret model with Google Sign-In
# before linking this site publicly. See apps-script/Code.gs file header.
VITE_APPS_SCRIPT_SHARED_SECRET=replace-with-the-value-from-script-properties
