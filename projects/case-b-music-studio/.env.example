# Apps Script web app /exec URL.
#
# Get this from: Apps Script editor → Deploy → Manage deployments →
# copy the "Web app" URL ending in /exec.
#
# Copy this file to .env.local and paste the real URL there.
# .env.local is gitignored at the repo root.
VITE_APPS_SCRIPT_BASE_URL=https://script.google.com/macros/s/REPLACE_WITH_YOUR_DEPLOYMENT_ID/exec

# Shared secret sent with every POST to the Apps Script web app.
#
# Must exactly match the SHARED_SECRET property in Apps Script Project
# Settings → Script Properties:
#   Property: SHARED_SECRET
#   Value:    <same value as below>
#
# Generate a fresh value with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# IMPORTANT: this secret is bundled into the deployed JS — anyone who
# can open the deployed site in DevTools can read it. Treat the
# deployed URL as private (don't link publicly).
VITE_APPS_SCRIPT_SHARED_SECRET=replace-with-the-value-from-script-properties
