# Pomfret Voices DEI site — environment variables
# Copy this file to .env.local (gitignored) and fill in real values before deployment.

# ──────────────────────────────────────────────────────────────────────────────
# Site URL — required for Open Graph, canonical links, and sitemap generation.
# Use the final production domain (no trailing slash). In preview/staging, set
# to the Vercel URL for that environment.
NEXT_PUBLIC_SITE_URL=https://pomfretvoices.org

# ──────────────────────────────────────────────────────────────────────────────
# Sanity CMS credentials — required only when the CMS is wired up.
# The client throws at import time if these are missing, so they must be set
# before importing `lib/sanity/client.ts` anywhere.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# ──────────────────────────────────────────────────────────────────────────────
# Admin auth — protects /admin/* (QR generator).
#
# Generate a password hash:
#   $ node scripts/hash-password.mjs 'your-strong-password'
#   → outputs a bcrypt hash; paste into ADMIN_PASSWORD_HASH below
#
# Generate a session secret (32+ random bytes):
#   $ openssl rand -base64 48
#   → outputs a base64 string; paste into SESSION_SECRET below
#
# All three are required. Missing any of them fails admin auth closed.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# ──────────────────────────────────────────────────────────────────────────────
# OPTIONAL: Vercel KV / Upstash Redis credentials — enables durable login rate
# limiting (5 attempts / 15 min / IP, sliding window). Without these, the
# rate limiter falls back to per-instance memory, which works for low-traffic
# admin use but loses state on cold starts.
#
# Provision: Vercel Dashboard → Storage → Create KV. Vercel auto-injects:
KV_REST_API_URL=
KV_REST_API_TOKEN=
