# Pomfret DEI — environment variables.
# Copy this file to `.env.local` and fill in real values for local development.
# Do NOT commit `.env.local`.

# Sanity CMS (used by lib/sanity/client.ts when CMS-backed pages are wired).
# Project ID and dataset are public; the API token is sensitive and should only
# be present in server-side environments.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=

# Public URL of the deployed site. Used by the QR code generator at
# /admin/qr-generator to build absolute /tour/<slug> links printed on signage.
# Override this in production to match the live host (e.g. https://dei.pomfret.org).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
